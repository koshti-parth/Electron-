{
  "name": "electron",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "nodemon --exec electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "app-electron",
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "extraResources": [
      "resources/**"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mongoose": "^8.19.3",
    "nedb-promises": "^6.2.3",
    "nodemon": "^3.1.11",
    "puppeteer-core": "^22.15.0",
    "puppeteer-in-electron": "^3.0.5"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  }
}
